// Réglages Cloudflare : le Worker « tribune » sert les pages du dépôt (overlay, vestiaire)
// et enregistre les looks des viewers (src/worker.js) dans un espace KV créé automatiquement au déploiement.
{
  "name": "tribune",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    { "binding": "LOOKS" }
  ]
}
